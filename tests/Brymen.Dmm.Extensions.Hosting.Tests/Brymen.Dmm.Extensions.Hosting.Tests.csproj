<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Os dois alvos do pacote: o net8.0 roda no runtime 8.0 (LTS), com o Microsoft.Extensions.* 8.0. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- O Generic Host completo (HostApplicationBuilder), na versão de cada alvo, como num app de verdade. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- O Brymen.Dmm referencia o Protocol e o Hid com PrivateAssets="all" (vão dentro do pacote): aqui, diretamente. -->
    <ProjectReference Include="..\..\src\Brymen.Dmm.Extensions.Hosting\Brymen.Dmm.Extensions.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Brymen.Dmm\Brymen.Dmm.csproj" />
    <ProjectReference Include="..\..\src\Brymen.Dmm.Protocol\Brymen.Dmm.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Brymen.Dmm.Hid\Brymen.Dmm.Hid.csproj" />
  </ItemGroup>

</Project>
