<?xml version="1.0" encoding="utf-8"?>
<!--
  Feeds dos exemplos em samples/. O ConsoleSample e o WorkerSample consomem os PACOTES Brymen.Dmm e
  Brymen.Dmm.Extensions.Hosting do feed local ../artifacts/packages, gerado por:

    dotnet pack src/Brymen.Dmm -c Release -o artifacts/packages
    dotnet pack src/Brymen.Dmm.Extensions.Hosting -c Release -o artifacts/packages

  O mapeamento de origens (packageSourceMapping) busca os pacotes Brymen.Dmm* só no feed local e todos os outros só no
  nuget.org. Ele também evita o erro NU1301 ("a fonte local não existe") nos exemplos que não usam o feed local, como o
  SignalRClient: sem o mapeamento, um clone novo, ainda sem artifacts/packages, não restauraria nenhum projeto daqui.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="brymen-local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="brymen-local">
      <package pattern="Brymen.Dmm" />
      <package pattern="Brymen.Dmm.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
