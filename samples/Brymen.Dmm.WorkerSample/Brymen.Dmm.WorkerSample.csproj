<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Analisadores de trimming/AOT: o worker também pode ser publicado trimmed (Raspberry Pi) ou com Native AOT. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <!-- Os PACOTES, e não os projetos: vêm do feed local artifacts/packages (veja ../nuget.config), na versão do
         Directory.Build.props. O Brymen.Dmm vem como dependência do Brymen.Dmm.Extensions.Hosting. Gere os dois antes com
         "dotnet pack src/Brymen.Dmm.Extensions.Hosting -c Release -o artifacts/packages" e o mesmo para src/Brymen.Dmm. -->
    <PackageReference Include="Brymen.Dmm.Extensions.Hosting" Version="$(Version)" />
  </ItemGroup>

</Project>
