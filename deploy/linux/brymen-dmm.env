# Variáveis de ambiente locais do serviço brymen-dmm (lidas pela unit via EnvironmentFile=).
# O install.sh copia este modelo para /etc/brymen-dmm/brymen-dmm.env só se o arquivo não existir,
# então as suas alterações sobrevivem às atualizações. Depois de editar:
#   sudo systemctl restart brymen-dmm
#
# As chaves seguem a configuração do appsettings.json, com "__" no lugar de ":".
# Os valores daqui prevalecem sobre os Environment= da unit.

# Transporte: Auto | Hid | Simulated (Simulated não precisa do cabo).
#Meter__Transport=Auto

# Caminho do hidraw. O padrão da unit é o symlink da regra udev; vazio usa o primeiro VID 0820/PID 0001.
#Meter__DevicePath=/dev/brymen-bu86x

# Abre o cabo e começa o polling ao iniciar.
#Meter__AutoLink=true

# Intervalo entre consultas 52 66 (TimeSpan, padrão 200 ms).
#Meter__PollInterval=00:00:00.200
#Meter__ReportTimeout=00:00:01
#Meter__ReconnectDelay=00:00:02

# Gravação (Graphical Recorder / Data List). O buffer fica na memória (130 a 430 bytes por amostra):
# em placas com 512 MB de RAM (Pi Zero 2 W, Pi 3 A+) use MaxSamples=200000.
#Acquisition__MaxSamples=1000000
#Acquisition__BackupDirectory=/var/lib/brymen-dmm/backup
#Acquisition__BackupEnabled=true
# Quantos backups ~BDMDLn.csv ficam na pasta (1 a 100000); os mais antigos são apagados.
#Acquisition__BackupRetention=20

# Quantas importações do datalogger terminadas ficam guardadas (memória e imports/, 1 a 1000).
#Logger__ImportRetention=10

# Hub SignalR /hubs/meter: ping do servidor e mensagens de exceção para o cliente (só diagnóstico).
#SignalR__KeepAliveInterval=00:00:15
#SignalR__EnableDetailedErrors=false

# Intervalo do evento heartbeat do SSE (/api/v1/readings/stream).
#Sse__HeartbeatInterval=00:00:15

# Origens de clientes browser de outra origem (REST e SignalR), uma por índice; vazio = sem CORS.
# Páginas de outras origens não alteram o estado nem abrem o WebSocket do hub (403 FORBIDDEN).
#Cors__AllowedOrigins__0=http://192.168.0.10:8080

# Nomes e IPs aceitos no cabeçalho Host, separados por ";" (proteção contra DNS rebinding); "*" aceita todos.
#AllowedHosts=raspberrypi.local;192.168.0.10;localhost

# Porta de escuta: altere as duas variáveis (veja o comentário na unit).
#ASPNETCORE_URLS=http://0.0.0.0:5080
#Urls=http://0.0.0.0:5080

# Nível de log.
#Logging__LogLevel__Default=Information
