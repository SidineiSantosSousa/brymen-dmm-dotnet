{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "Meter": {
    "Transport": "Auto",
    "DevicePath": null,
    "AutoLink": true,
    "PollInterval": "00:00:00.200",
    "ReportTimeout": "00:00:01",
    "ReconnectDelay": "00:00:02"
  },
  "Acquisition": {
    "MaxSamples": 1000000,
    "BackupDirectory": null,
    "BackupRetention": 20
  },
  "Logger": {
    "ImportRetention": 10
  },
  "SignalR": {
    "EnableDetailedErrors": false,
    "KeepAliveInterval": "00:00:15"
  },
  "Sse": {
    "HeartbeatInterval": "00:00:15"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DataDirectory": null
}
